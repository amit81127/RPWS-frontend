# Backend Environment Configuration
PORT=5000

# Database Connection:
# Local MongoDB: mongodb://127.0.0.1:27017/ratingdb
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-address>/ratingdb?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/ratingdb

# Authentication Security:
# Strong random secret (minimum 32 characters). Server refuses to start in production if unset.
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Environment and Network:
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=5

# Rate Limiting & Overload Protection (Campus Exhibition Tuning)
RATE_LIMIT_STORE=mongo          # 'mongo' for multi-instance distributed sync, or 'memory'
RATE_LIMIT_LOGIN_MAX=30         # 30 login attempts / 15 min per account (NAT-safe)
RATE_LIMIT_SIGNUP_MAX=60        # 60 registrations / 15 min per IP
RATE_LIMIT_AUTH_MAX=100         # 100 admin registration attempts / 15 min
RATE_LIMIT_READ_MAX=10000       # 10,000 public reads / 1 min (NAT-safe elevated pool)
RATE_LIMIT_VOTE_MAX=240         # 240 votes / 1 min per authenticated student (voter-keyed)
RATE_LIMIT_UPLOAD_MAX=100       # 100 uploads / 15 min
RATE_LIMIT_ADMIN_MAX=120        # 120 admin operations / 15 min
RATE_LIMIT_IMAGE_MAX=1200       # 1,200 image requests / 1 min


# Cloudinary Storage Configuration:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
