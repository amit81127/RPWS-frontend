# Backend Environment Configuration
PORT=5000

# Database Connection:
# Local MongoDB: mongodb://127.0.0.1:27017/ratingdb
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-address>/ratingdb?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/ratingdb

# Authentication Security:
# Strong random secret (minimum 32 characters). Server refuses to start in production if unset.
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Environment and Network:
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Administrative Provisioning (Used by scripts/createAdmin.js):
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=secure_admin_password_min_8_chars

# Cloudinary Storage Configuration:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
