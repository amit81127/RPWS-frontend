# Backend Environment Configuration
PORT=5000

# Database Connection:
# Local MongoDB: mongodb://127.0.0.1:27017/ratingdb
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-address>/ratingdb?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/ratingdb

# Authentication Security:
# Strong random secret (minimum 32 characters). Server refuses to start in production if unset.
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Environment and Network:
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=20
RATE_LIMIT_AUTH_MAX=2000
RATE_LIMIT_READ_MAX=10000
RATE_LIMIT_VOTE_MAX=500
RATE_LIMIT_UPLOAD_MAX=200


# Cloudinary Storage Configuration:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
